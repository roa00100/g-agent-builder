# 복사해서 .env 를 만든다. .env 는 커밋하지 않는다.

# --- PostgreSQL ---
# docker compose 는 이 값으로 계정과 DB 를 만들고, 앱은 같은 값으로 접속한다.
# 이 PC 안에서만 쓰는 개발용 값이다.
POSTGRES_USER=agent_builder
POSTGRES_PASSWORD=agent_builder_dev
POSTGRES_DB=agent_builder
POSTGRES_HOST=127.0.0.1
# PC 에서 붙는 포트. compose 가 이 포트를 컨테이너의 5432 에 잇는다.
POSTGRES_PORT=5432

# --- Redis ---
# docker compose 와 앱이 같은 값을 쓴다.
REDIS_HOST=127.0.0.1
# PC 에서 붙는 포트. compose 가 이 포트를 컨테이너의 6379 에 잇는다.
REDIS_PORT=6379
# Redis 안의 DB 번호 (0~15).
REDIS_DB=0
# 비워 두면 비밀번호 없이 돈다. 적으면 compose 의 Redis 가 이 비밀번호를 요구하고 앱도 이것으로 붙는다.
# 바꾼 뒤에는 `docker compose up -d --wait` 로 Redis 컨테이너를 다시 만든다.
REDIS_PASSWORD=

# --- 오브젝트 스토리지 (SeaweedFS, S3 API) ---
# docker compose 와 앱이 같은 값을 쓴다.
STORAGE_HOST=127.0.0.1
# PC 에서 붙는 포트. compose 가 이 포트를 컨테이너의 S3 포트 8333 에 잇는다.
STORAGE_PORT=8333
# S3 접근 키. compose 의 SeaweedFS 가 이 키로 인증을 요구한다. 이 PC 안에서만 쓰는 개발용 값이다.
STORAGE_ACCESS_KEY=agent_builder
STORAGE_SECRET_KEY=agent_builder_dev
# 파일을 담는 버킷. SeaweedFS 가 시작할 때 만든다.
STORAGE_BUCKET=agent-builder

# --- runtime 실행 모드 ---
# cli(기본) 또는 rest. 실행할 때 --profile 인자를 주면 그쪽이 이긴다.
# RUNTIME_PROFILE=cli
# REST 서버 주소. 기본 127.0.0.1:8000 — 인증이 없으므로 바깥에 열지 않는다.
# REST_HOST=127.0.0.1
# REST_PORT=8000

# --- 비밀 값 암호화 ---
# 공급자 API 키 같은 비밀을 DB·캐시에 암호문으로 두는 마스터 키(Fernet). 만들려면:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 이 키를 잃으면 저장해 둔 공급자 키를 풀 수 없다 — 키를 다시 넣어야 한다.
SECRET_ENCRYPTION_KEY=

# --- 관측 (로그·추적) ---
# 로그 단계: TRACE · DEBUG · INFO(기본) · WARNING · ERROR.
#   INFO  호출 하나의 요약(모델·토큰·비용·걸린 시간)
#   DEBUG 갈림길(캐시 적중, 연결 열기, 고른 대기 시간)
#   TRACE 오간 데이터 전체 — 보낸 문장과 받은 답이 그대로 남는다. 필요할 때만 켠다.
# 비밀(API 키·암호문 등)은 단계와 상관없이 지운다.
# 셸(명령 없이 실행)은 LOG_LEVEL 을 주지 않으면 WARNING 으로 돈다 — 화면을 깨끗하게.
# LOG_LEVEL=INFO
# console(기본, 사람이 읽기 쉬움) 또는 json(수집기가 읽음).
# LOG_FORMAT=console
# 추적을 보낼 OTLP HTTP 주소. 비우면 보내지 않는다(로그의 trace_id 는 그대로 붙는다).
# 로컬 Jaeger: `docker compose --profile observability up -d` 뒤 http://127.0.0.1:16686 에서 본다.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=agent-builder

# --- 모델 공급자 ---
# 공급자의 주소·API 키·대기 시간은 환경변수가 아니라 공급자 프로필(DB)에 둔다.
#   python -m agent_builder_runtime model-provider set openrouter --base-url https://openrouter.ai/api/v1 --timeout 60
#   python -m agent_builder_runtime model-provider set-key openrouter

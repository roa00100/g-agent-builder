# 복사해서 .env 를 만든다. .env 는 커밋하지 않는다.

# --- PostgreSQL ---
# docker compose 는 이 값으로 계정과 DB 를 만들고, 앱은 같은 값으로 접속한다.
# 이 PC 안에서만 쓰는 개발용 값이다.
POSTGRES_USER=agent_builder
POSTGRES_PASSWORD=agent_builder_dev
POSTGRES_DB=agent_builder
POSTGRES_HOST=127.0.0.1
# PC 에서 붙는 포트. compose 가 이 포트를 컨테이너의 5432 에 잇는다.
POSTGRES_PORT=5432

# --- Redis ---
# docker compose 와 앱이 같은 값을 쓴다.
REDIS_HOST=127.0.0.1
# PC 에서 붙는 포트. compose 가 이 포트를 컨테이너의 6379 에 잇는다.
REDIS_PORT=6379
# Redis 안의 DB 번호 (0~15).
REDIS_DB=0
# 비워 두면 비밀번호 없이 돈다. 적으면 compose 의 Redis 가 이 비밀번호를 요구하고 앱도 이것으로 붙는다.
# 바꾼 뒤에는 `docker compose up -d --wait` 로 Redis 컨테이너를 다시 만든다.
REDIS_PASSWORD=

# --- 오브젝트 스토리지 (SeaweedFS, S3 API) ---
# docker compose 와 앱이 같은 값을 쓴다.
STORAGE_HOST=127.0.0.1
# PC 에서 붙는 포트. compose 가 이 포트를 컨테이너의 S3 포트 8333 에 잇는다.
STORAGE_PORT=8333
# S3 접근 키. compose 의 SeaweedFS 가 이 키로 인증을 요구한다. 이 PC 안에서만 쓰는 개발용 값이다.
STORAGE_ACCESS_KEY=agent_builder
STORAGE_SECRET_KEY=agent_builder_dev
# 파일을 담는 버킷. SeaweedFS 가 시작할 때 만든다.
STORAGE_BUCKET=agent-builder

# --- 모델 공급자 ---
# https://openrouter.ai/keys 에서 받은 키를 .env 에만 적는다.
OPENROUTER_API_KEY=

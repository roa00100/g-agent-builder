# 복사해서 .env 를 만든다. .env 는 커밋하지 않는다.

# --- 로컬 PostgreSQL (docker-compose.yml 이 읽는다) ---
# 이 PC 안에서만 쓰는 개발용 값이다.
POSTGRES_USER=agent_builder
POSTGRES_PASSWORD=agent_builder_dev
POSTGRES_DB=agent_builder
POSTGRES_PORT=5432

# --- 애플리케이션 ---
# 위 값과 같아야 한다. 드라이버는 psycopg 3.
DATABASE_URL=postgresql+psycopg://agent_builder:agent_builder_dev@127.0.0.1:5432/agent_builder

# --- 모델 공급자 ---
# https://openrouter.ai/keys 에서 받은 키를 .env 에만 적는다.
OPENROUTER_API_KEY=
